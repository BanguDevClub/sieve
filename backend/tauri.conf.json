{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sieve",
  "version": "0.1.0",
  "identifier": "club.bangudev.sieve",
  "build": {
    "beforeDevCommand": "node -e \"const fs=require('fs'),cp=require('child_process');const d=fs.existsSync('frontend')?'frontend':'../frontend';cp.spawn('npm',['--prefix',d,'run','dev'],{stdio:'inherit',shell:true})\"",
    "beforeBuildCommand": "node -e \"const fs=require('fs'),cp=require('child_process');const d=fs.existsSync('frontend')?'frontend':'../frontend';process.exit(cp.spawnSync('npm',['--prefix',d,'run','build'],{stdio:'inherit',shell:true}).status||0)\"",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sieve - BanguDevClub",
        "width": 1360,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright © 2026 BanguDevClub",
    "shortDescription": "High-performance desktop app for huge CSV files with DuckDB",
    "longDescription": "Sieve is an ultra-fast desktop tool for opening and querying massive CSV files out-of-core using DuckDB, Svelte 5, and Tauri.",
    "category": "DeveloperTool"
  }
}
